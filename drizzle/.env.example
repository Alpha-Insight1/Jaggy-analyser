# Supabase (Project Settings -> API). The publishable/anon key is safe in the browser;
# access is enforced by Row Level Security and signed-in checks in the edge functions.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Set to "false" to hide account creation on the sign-in page (invite-only).
VITE_ALLOW_SIGNUP=true

# Optional: Firebase Cloud Messaging for background phone push (when app is closed).
# In-app sound/toast alerts work without these. Get values from Firebase Console → Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_MESSAGING_SENDER_ID=
